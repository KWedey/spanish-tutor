# Build / cache
__pycache__/
.pytest_cache/
*.pyc
.venv/

# Obsidian workspace (user-specific layout)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Claude Code user data (memory, settings — personal per user)
.claude/

# Superpowers plugin state
.superpowers/
docs/superpowers/

# State snapshots
state/.snapshot/

# ============================================================
# Learner-specific data (everything below this line)
# Regenerated by: python3 scripts/setup.py
# ============================================================

# Learner state files (generated by scripts/init-student.py)
state/learner-profile.yaml
state/schedule.yaml
state/skill-map.yaml
state/system-health.yaml
state/resource-tracker.yaml

# Session logs and archives
state/sessions/*
!state/sessions/.gitkeep
state/sessions/archive/*
!state/sessions/archive/.gitkeep

# Weekly summaries
state/summaries/*
!state/summaries/.gitkeep

# Milestones and offline guides
state/milestones/*
!state/milestones/.gitkeep
state/offline-guides/*
!state/offline-guides/.gitkeep

# Journal entries
journal/*
!journal/.gitkeep

# Session transcripts
transcripts/*
!transcripts/.gitkeep

# Progress reports
progress-reports/*
!progress-reports/.gitkeep

# Parking lot (personal notes between sessions)
parking-lot.md

# Generated vault content (regenerated by scripts/generate-vault.py --full)
# Directory structure preserved via .gitkeep files
vault/*.md
vault/**/*.md
